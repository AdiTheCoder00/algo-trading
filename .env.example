# Copy this file to `.env` and fill it in. Brief §2.7 — no secrets in the repo.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit it, and never paste these values into a chat
# window, an issue, or a log. If one is ever exposed, regenerate it in the broker
# developer portal rather than hoping nobody noticed.
#
# To check what loaded without printing any of it:
#
#   algo credentials
#
# That reports which variables are set and how long each value is — enough to
# diagnose a truncated key or a stray newline, and nothing more.

# ------------------------------------------------------------ SmartAPI (bars)
#
# Angel One SmartAPI serves the historical/closed bars in the live loop (candle
# API). Login needs all four of these — the API key on its own authenticates
# nothing; a session is opened with the client code and MPIN plus a fresh
# six-digit code generated from the TOTP seed each time.

# From the SmartAPI developer portal, for your app.
ALGO_SMARTAPI_API_KEY=your-api-key

# Your Angel One client / login ID.
ALGO_SMARTAPI_CLIENT_ID=your-client-id

# The MPIN you set for API login. Not your web password unless they are the same.
ALGO_SMARTAPI_PASSWORD=your-password-or-pin

# The base32 secret shown when you enable TOTP — the string behind the QR code,
# not the six digits your authenticator currently displays. Those rotate every
# thirty seconds; the secret does not.
ALGO_SMARTAPI_TOTP_SEED=your-base32-totp-seed

# ------------------------------------------------------ Kotak Neo (live)
#
# The live broker: orders, positions, funds, the chain feed and the live scrip
# master. Session = TOTP login (seed + MPIN) on every connect; the SDK cannot
# restore a trade session from an access token alone.

# From the Kotak Neo developer portal (api.kotaksecurities.com/openapi). The
# portal validates requests against whitelisted IPs — register this machine's
# public IP in the app's Primary/Secondary IP fields or the key is rejected.
ALGO_KOTAK_CONSUMER_KEY=your-consumer-key

# Your registered mobile number, with country code.
ALGO_KOTAK_MOBILE_NUMBER=+919876543210

# Your client code / UCC, as shown in the Kotak Neo app profile.
ALGO_KOTAK_UCC=your-ucc

# The base32 TOTP seed for API login. If the API reports "TOTP not registered",
# enrol the seed in the portal's TOTP section — the app's own 2FA and the API's
# TOTP are separate enrollments.
ALGO_KOTAK_TOTP_SEED=your-base32-totp-seed

# The MPIN you use in the Kotak Neo app for order confirmation.
ALGO_KOTAK_MPIN=your-mpin

# Optional. Kotak issues the script-details endpoints (scrip master, quotes)
# under a separate Market Data API app, whose consumer key can differ from the
# trading app's. When unset, CONSUMER_KEY is used for market data too.
ALGO_KOTAK_MARKET_DATA_KEY=

# ------------------------------------------------------------ live trading
#
# Brief §2.1. Live requires THREE things to agree: this variable set to exactly
# `live` (lowercase, no spaces), `mode: live` in the config file, AND the
# --i-understand-this-is-real-money flag on the command line.
#
# Leave it unset. Setting it while the config says otherwise is refused rather
# than resolved, so a stale line here cannot quietly arm anything.
# TRADING_MODE=

# ------------------------------------------------------------- monitoring
#
# Guards the API's kill-switch endpoint. Any long random string; it only has to
# match the value the dashboard uses. The API refuses to start without it.
ALGO_API_TOKEN=

# --- Alerts (algo/live/alerts.py) -------------------------------------------
# Proactive notifications: loop started/stopped, orders placed, orders the
# router refused. Optional - an unconfigured run logs alerts instead of
# messaging them, and never fails to start because these are unset.
#
# Read directly from the environment and deliberately excluded from the config
# schema: a secret that reaches AppConfig reaches config_hash, which is stamped
# into every signal id and run artefact.
ALGO_TELEGRAM_BOT_TOKEN=
ALGO_TELEGRAM_CHAT_ID=

# --- LLM (litellm-config.yaml) -----------------------------------------------
# Routes the "nemotron-3-super" model name through NVIDIA's OpenAI-compatible
# endpoint. Get a key from build.nvidia.com, then run the local proxy with:
#
#   litellm --config litellm-config.yaml
ALGO_NVIDIA_API_KEY=your-nvidia-api-key
