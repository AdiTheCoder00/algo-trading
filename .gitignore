# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Data and run artefacts
/data/
/runs/
/state/
/logs/
*.parquet
*.duckdb
*.db
*.db-wal
*.db-shm
report.html
tearsheet-sample.html
trades.csv
dashboard/public-tearsheet.html
# Study artefacts that a run regenerates. The run REPORT is committed - it is
# the finding - but the tearsheet and the per-trade log are large, derived, and
# reproduced byte for byte by `scripts/backtest_xauusd_rsi_stoch.py`.
/reports/**/*.html
/reports/**/*_trades.csv

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

