# Copy this file to `.env` next to macd_alert.py and fill it in.
#
#   cp .env.example .env
#
# Never commit `.env`, and never paste these values into a chat window or an
# issue. If a token leaks, revoke it (@BotFather -> /revoke) rather than hoping
# nobody noticed.

# ----------------------------------------------------------------- Telegram

# From @BotFather: /newbot, then copy the token it prints.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Where the alerts go. For a personal chat, message your bot once and read the
# id from https://api.telegram.org/bot<TOKEN>/getUpdates -> result[].message.chat.id
# For a group, add the bot to the group first; group ids are negative.
TELEGRAM_CHAT_ID=123456789

# ----------------------------------------------------------------- exchange

# Any ccxt exchange id: binance, bybit, kraken, coinbase, okx, kucoin, ...
EXCHANGE_ID=binance

# OPTIONAL. Public OHLCV needs no credentials on most exchanges - leave these
# blank unless yours requires a key for candles, or you want the higher
# authenticated rate limit. Read-only keys are enough; this script never trades.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Only some exchanges (okx, kucoin, ...) use a passphrase.
EXCHANGE_API_PASSWORD=

# ------------------------------------------------------------------ what to watch

# One pair, or several separated by commas: BTC/USDT,ETH/USDT
# Two kinds of symbol can be mixed freely, routed by shape - a "/" means
# EXCHANGE_ID above (ccxt unified format); no "/" means MT5 (a real,
# logged-in terminal, symbol exactly as your broker lists it, e.g. XAUUSD).
# MT5 support needs the repo's own venv, not this tool's isolated one - see
# the "MT5" section below. Only seeds the watch list the first time it runs;
# see WATCHLIST_FILE / the command panel further down for what happens after.
TRADING_PAIR=BTC/USDT

# Candle size: 1m, 5m, 15m, 1h, 4h, 1d, ... whatever the exchange offers.
TIMEFRAME=1h

# ------------------------------------------------------------------ indicator

MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# How many candles to pull per poll. More than enough warmup for the EMAs; 300
# keeps the values stable and still fits a single request on every exchange.
CANDLE_LIMIT=300

# ------------------------------------------------------------------ runtime

# Seconds to wait after a candle closes before polling, so the exchange has
# published the finished bar. Raise it if you see the odd missed candle.
POLL_BUFFER_SECONDS=15

# Network retry policy. Delay grows as base * 2^(attempt-1), tripled for 429s.
MAX_RETRIES=5
RETRY_BASE_DELAY=2

# Where the last-alerted candle per pair is remembered, so a restart does not
# re-send an alert you already got.
STATE_FILE=state.json

# Timestamps in the alert message. Any IANA name: UTC, Asia/Kolkata, ...
DISPLAY_TIMEZONE=UTC

# Send a short "monitor started" message on launch - handy for confirming the
# token and chat id are right without waiting for a real crossover.
SEND_STARTUP_MESSAGE=true

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------ command panel

# Lets you message the live bot to change what it watches - /watch ETH/USDT,
# /unwatch BTC/USDT, /list, /help - with no restart. Commands are accepted
# ONLY from TELEGRAM_CHAT_ID above; anyone else's message is read (so it
# doesn't get reprocessed) but never acted on. Set false for a read-only
# deployment that never listens for anything inbound.
ENABLE_COMMAND_PANEL=true

# Where the live watch list is remembered. Once this file exists it is the
# source of truth - TRADING_PAIR only seeds it the first time the bot ever
# runs, so a /watch you sent last week survives a restart today.
WATCHLIST_FILE=watchlist.json

# ------------------------------------------------------------------ MT5
#
# Optional: only used for symbols in TRADING_PAIR / /watch that have no "/"
# (real, non-tokenized instruments like XAUUSD, via a MetaTrader 5 terminal).
# Needs the repo's own venv (has MetaTrader5 + algo), not this folder's
# isolated one - and a running, logged-in terminal with the symbol in Market
# Watch. If MetaTrader5 is not importable at all (this tool's own venv, or
# any non-Windows machine), MT5 symbols are simply unavailable - crypto
# symbols are unaffected either way.
#
# There is no separate MT5 timeframe or symbol setting: TRADING_PAIR carries
# the symbol (some brokers suffix it - XAUUSD.a, XAUUSDm - check Market Watch
# if it is refused), and MT5 uses the SAME TIMEFRAME as the exchange above,
# converted automatically. If that period is not one MT5 offers (5, 15, 30,
# 60, or 240 minutes - a ccxt-only period like 3m has no MT5 equivalent), MT5
# symbols are unavailable for that run; crypto symbols still work.

# Cosmetic only - shown in alert messages and logs for any symbol routed here.
MT5_BROKER_LABEL=MT5
