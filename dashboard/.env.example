# The engine's monitoring API. Read by the Next.js SERVER only.
ALGO_API_URL=http://127.0.0.1:8000

# Must match ALGO_API_TOKEN on the engine side.
#
# Note the name: no NEXT_PUBLIC_ prefix, deliberately. A NEXT_PUBLIC_ variable is
# inlined into the browser bundle, which would ship the token that guards the kill
# switch to anyone who opens devtools. All API calls go through the server-side
# proxy in app/api/state/ so the token never leaves the machine.
ALGO_API_TOKEN=change-me
